# Copy to config.env (gitignored) and set the values for this host, then `make install`.
# KEY=VALUE per line, no quotes; ~ is expanded in paths.

# Required
CODEX_MCP_PYTHON=/path/to/python3.12
CODEX_MCP_BIN=/path/to/bin/codex
CODEX_MCP_HOST=host.example.com

# Optional (these are the defaults)
CODEX_MCP_DEFAULT_SANDBOX=read-only
CODEX_MCP_TIMEOUT=1800
CODEX_MCP_MAX_PARALLEL=2
CODEX_MCP_LOG=~/.local/state/codex-mcp/runs.jsonl
CLAUDE_BIN=claude
CLAUDE_CONFIG=~/.claude.json
# Comma-separated words that must never be committed (company, project or user names).
LEAKCHECK_WORDS=
